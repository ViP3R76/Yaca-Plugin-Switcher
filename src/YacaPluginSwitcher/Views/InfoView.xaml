<UserControl x:Class="YacaPluginSwitcher.InfoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}">
<Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="1.15*"/><RowDefinition Height="0.9*"/><RowDefinition Height="0.8*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Margin="0,0,6,6" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"><StackPanel><TextBlock Text="YACA" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="YacaDescription" Margin="0,8,0,6" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/><ItemsControl x:Name="YacaLinks"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Item1}" Tag="{Binding Item2}" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource AccentBrush}" HorizontalContentAlignment="Left"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
<Border Grid.Column="1" Margin="6,0,0,6" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"><StackPanel><TextBlock Text="TEAMSPEAK 3" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="TsDescription" Margin="0,8,0,6" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/><ItemsControl x:Name="TsLinks"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Item1}" Tag="{Binding Item2}" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource AccentBrush}" HorizontalContentAlignment="Left"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
<Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock Text="SNAKENEST COMMUNITY" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Tag="https://discord.gg/9AxuZkyU7P" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Padding="12,6"><StackPanel Orientation="Horizontal"><Image Source="/YacaPluginSwitcher;component/Assets/discord_icon.png" Width="22" Height="22" Margin="0,0,8,0"/><TextBlock Text="Discord" VerticalAlignment="Center"/></StackPanel></Button><Button Tag="https://twitch.tv/vip3r_76" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Padding="12,6"><TextBlock Text="Twitch  •  twitch.tv/vip3r_76" VerticalAlignment="Center"/></Button><Button Tag="https://github.com/ViP3R76/Yaca-Plugin-Switcher" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Padding="12,6"><StackPanel Orientation="Horizontal"><Image Source="/YacaPluginSwitcher;component/Assets/github_icon.png" Width="22" Height="22" Margin="0,0,8,0"/><TextBlock Text="GitHub" VerticalAlignment="Center"/></StackPanel></Button></StackPanel></StackPanel></Border>
<Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock Text="DISCLAIMER" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/><TextBlock x:Name="LegalText" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="900"/></StackPanel></Border>
</Grid></UserControl>