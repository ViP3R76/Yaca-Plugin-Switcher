<Window x:Class="YacaPluginSwitcher.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Width="560" Height="220" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}">
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}" Padding="26">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="YACA Plugin Switcher" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,18,0,14" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ProgressBar Grid.Row="2" Height="5" IsIndeterminate="True"/>
        </Grid>
    </Border>
</Window>