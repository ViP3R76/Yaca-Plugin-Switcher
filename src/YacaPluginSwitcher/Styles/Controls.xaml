<Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,7"/></Style>
