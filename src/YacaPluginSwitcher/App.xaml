<Application x:Class="YacaPluginSwitcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
                <ResourceDictionary Source="Styles/ScrollBarTheme.xaml" />
                <ResourceDictionary Source="Styles/DataGridTheme.xaml" />
                <ResourceDictionary Source="Styles/DarkScrollViewerTheme.xaml" />
                <ResourceDictionary Source="Styles/SortButton.xaml" />
                <ResourceDictionary Source="Styles/Navigation.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                These implicit application-level styles are the authoritative
                defaults for framework-created scrolling controls. Keeping the
                implicit keys directly in Application.Resources avoids relying on
                template/runtime event ordering.
            -->
            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
            <Style TargetType="ScrollViewer" BasedOn="{StaticResource DarkScrollViewerStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
