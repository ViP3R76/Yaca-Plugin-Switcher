<UserControl x:Class="YacaPluginSwitcher.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="8,4,8,14">
            <TextBlock x:Name="PageTitle" Text="INFO &amp; LINKS" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="PageSubtitle" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource SecondaryBrush}" />
            <Border Height="1" Margin="0,10,0,0" Background="{StaticResource AccentBrush}" Opacity="0.65" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="YacaHeader" Text="YACA SYSTEMS" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock x:Name="YacaDescription" Margin="0,7,0,14" Foreground="{StaticResource SecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,9" />
                            <ItemsControl x:Name="YacaLinks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Text}" Tag="{Binding Url}" Click="Link_Click" Style="{DynamicResource LinkButtonStyle}" Foreground="{StaticResource AccentBrush}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,3" MinHeight="34" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="TsHeader" Text="TEAMSPEAK 3" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock x:Name="TsDescription" Margin="0,7,0,14" Foreground="{StaticResource SecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,9" />
                            <ItemsControl x:Name="TsLinks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Text}" Tag="{Binding Url}" Click="Link_Click" Style="{DynamicResource LinkButtonStyle}" Foreground="{StaticResource AccentBrush}" HorizontalContentAlignment="Left" Padding="10,6" Margin="0,0,0,3" MinHeight="34" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Margin="6,12,6,0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CommunityHeader" Text="SNAKENEST COMMUNITY" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock x:Name="CommunityDescription" Grid.Row="1" Margin="0,5,0,12" FontSize="14" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" />
                        <UniformGrid x:Name="CommunityLinksGrid" Grid.Row="2" Columns="4" Rows="1">
                            <Button Tag="https://discord.gg/9AxuZkyU7P" Click="Link_Click" Style="{DynamicResource LinkButtonStyle}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Padding="10,7" Margin="0,0,5,0" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal"><Image Source="/YacaPluginSwitcher;component/Assets/discord_icon.png" Width="25" Height="25" Margin="0,0,9,0" /><StackPanel><TextBlock Text="SNAKENEST COMMUNITY" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="DiscordLinkText" Text="Discord Community" FontSize="12" Foreground="{StaticResource SecondaryBrush}" /></StackPanel></StackPanel>
                            </Button>
                            <Button Tag="https://twitch.tv/vip3r_76" Click="Link_Click" Style="{DynamicResource LinkButtonStyle}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Padding="10,7" Margin="2.5,0,2.5,0" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal"><ContentControl x:Name="TwitchIconHost" Width="28" Height="28" Margin="0,0,9,0" VerticalAlignment="Center" /><StackPanel><TextBlock Text="ViP3R_76" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="TwitchLinkText" Text="Twitch Stream" FontSize="12" Foreground="{StaticResource SecondaryBrush}" /></StackPanel></StackPanel>
                            </Button>
                            <Button Tag="https://github.com/ViP3R76/Yaca-Plugin-Switcher" Click="Link_Click" Style="{DynamicResource LinkButtonStyle}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Padding="10,7" Margin="2.5,0,2.5,0" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal"><Image Source="/YacaPluginSwitcher;component/Assets/github_icon.png" Width="25" Height="25" Margin="0,0,9,0" /><StackPanel><TextBlock Text="YACA Plugin Switcher" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="GitHubLinkText" Text="Project on GitHub" FontSize="12" Foreground="{StaticResource SecondaryBrush}" /></StackPanel></StackPanel>
                            </Button>
                            <Button Tag="https://ko-fi.com/vip3r76" Click="Link_Click" Style="{DynamicResource LinkButtonStyle}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Padding="10,7" Margin="5,0,0,0" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal"><Image Source="/YacaPluginSwitcher;component/Assets/kofi.png" Width="40" Height="28" Stretch="Uniform" Margin="0,0,9,0" /><StackPanel><TextBlock x:Name="KofiLinkText" Text="Ko-fi Support" FontSize="12" Foreground="{StaticResource SecondaryBrush}" /></StackPanel></StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Border>
                <Border Margin="6,12,6,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock x:Name="LegalHeader" Text="DISCLAIMER" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <Border Height="1" Background="{StaticResource AccentBrush}" Opacity="0.65" Margin="0,8,0,8" />
                        <TextBlock x:Name="LegalText" Foreground="{StaticResource ForegroundBrush}" FontSize="13" FontWeight="SemiBold" LineHeight="20" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
