<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Central fallback for ScrollBar instances created by WPF templates. -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />

    <!--
        ScrollViewer/DataGrid templates are framework-owned and may resolve
        their ScrollBars through theme resources rather than the implicit
        application style. App.xaml.cs therefore applies DarkScrollBarStyle
        centrally when every ScrollBar is loaded. No view-specific override
        is required.
    -->
</ResourceDictionary>
