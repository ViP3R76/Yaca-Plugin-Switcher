<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CA1826</NoWarn>
    <AssemblyName>YacaPluginSwitcher</AssemblyName>
    <RootNamespace>YacaPluginSwitcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(IntermediateOutputPath)branding_icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ReleasePackageName>YacaPluginSwitcher-v$(InformationalVersion)-win-x64</ReleasePackageName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\YacaPluginSwitcher.Core\YacaPluginSwitcher.Core.csproj" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <Resource Include="Assets\branding_logo.png" />
    <Resource Include="Assets\branding_icon.ico" />
    <Resource Include="Assets\discord_icon.png" />
    <Resource Include="Assets\github_icon.png" />
    <Resource Include="Assets\kofi.png" />
    <Resource Include="Assets\*.svg" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSymbolsInSingleFile>false</IncludeSymbolsInSingleFile>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\releases\</PublishDir>
  </PropertyGroup>
  <Target Name="GenerateApplicationIcon" BeforeTargets="CoreCompile" Inputs="$(MSBuildProjectDirectory)\Assets\branding_logo.png;$(MSBuildProjectDirectory)\Build\Generate-ApplicationIcon.ps1" Outputs="$(IntermediateOutputPath)branding_icon.ico">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\Generate-ApplicationIcon.ps1&quot; -InputPath &quot;$(MSBuildProjectDirectory)\Assets\branding_logo.png&quot; -OutputPath &quot;$(IntermediateOutputPath)branding_icon.ico&quot;" />
  </Target>
  <Target Name="PublishReleaseFromBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(YacaReleasePackaging)' != 'true'">
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Publish"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;PublishTrimmed=false;PublishDir=$(PublishDir);YacaReleasePackaging=true" />
  </Target>
</Project>