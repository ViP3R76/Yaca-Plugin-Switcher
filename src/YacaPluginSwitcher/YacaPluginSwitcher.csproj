<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CA1826</NoWarn>
    <AssemblyName>YacaPluginSwitcher</AssemblyName>
    <RootNamespace>YacaPluginSwitcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ReleasePackageName>YacaPluginSwitcher-v$(InformationalVersion)-win-x64</ReleasePackageName>
    <EnableDefaultApplicationIcon>false</EnableDefaultApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\YacaPluginSwitcher.Core\YacaPluginSwitcher.Core.csproj" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <Resource Include="Assets\yaca_logo.png" />
    <Resource Include="Assets\discord_icon.png" />
    <Resource Include="Assets\github_icon.png" />
    <Resource Include="Assets\*.svg" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSymbolsInSingleFile>false</IncludeSymbols>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <Target Name="PublishReleaseFromBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(YacaReleasePackaging)' != 'true'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:PublishTrimmed=false -p:YacaReleasePackaging=true --no-restore" />
  </Target>
</Project>