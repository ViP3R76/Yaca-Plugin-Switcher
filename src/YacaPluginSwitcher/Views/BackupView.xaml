<UserControl x:Class="YacaPluginSwitcher.BackupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}"><Grid Margin="6,6,0,0"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions><TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource ForegroundBrush}"/><Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10"><DataGrid x:Name="Grid" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single"><DataGrid.Columns><DataGridCheckBoxColumn Header="✓" Binding="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="48"/><DataGridTextColumn Header="YACA" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Datum" Binding="{Binding Timestamp,StringFormat=dd.MM.yyyy HH:mm:ss}" Width="180"/><DataGridTextColumn Header="Größe" Binding="{Binding FileSizeDisplay}" Width="120"/><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*"/></DataGrid.Columns></DataGrid></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="DeleteButton" Content="Backups löschen" Click="Delete_Click" Margin="6" Style="{StaticResource TileButtonStyle}"/><Button Content="Wiederherstellen" Click="Restore_Click" Margin="6" Style="{StaticResource TileButtonStyle}"/><Button Content="Schließen" Click="Close_Click" Margin="6" Style="{StaticResource TileButtonStyle}"/></StackPanel></Grid></UserControl>