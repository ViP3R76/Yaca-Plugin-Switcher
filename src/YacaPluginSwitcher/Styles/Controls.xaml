<Style TargetType="DockPanel"><Setter Property="Background" Value="{StaticResource ControlBrush}"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="LastChildFill" Value="True"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource ControlBrush}"/><Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/></Style>
