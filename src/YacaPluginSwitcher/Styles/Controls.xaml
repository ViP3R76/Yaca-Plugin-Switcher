<Style x:Key="ChromeCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}"/><Style x:Key="ToggleStyle" TargetType="ToggleButton"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="26"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
