<UserControl x:Class="YacaPluginSwitcher.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="8,4,8,18">
            <TextBlock x:Name="PageTitle" Text="INFO &amp; LINKS" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="PageSubtitle" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource SecondaryBrush}" />
            <Border Height="1" Margin="0,14,0,0" Background="{StaticResource AccentBrush}" Opacity="0.65" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,0,8,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="22">
                        <StackPanel>
                            <TextBlock x:Name="YacaHeader" Text="YACA SYSTEMS" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="YacaDescription" Margin="0,8,0,18" Foreground="{StaticResource SecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />
                            <ItemsControl x:Name="YacaLinks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Item1}"
                                                Tag="{Binding Item2}"
                                                Click="Link_Click"
                                                Style="{DynamicResource LinkButtonStyle}"
                                                Foreground="{StaticResource AccentBrush}"
                                                HorizontalContentAlignment="Left"
                                                Padding="10,8"
                                                Margin="0,0,0,5"
                                                MinHeight="38" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Padding="22">
                        <StackPanel>
                            <TextBlock x:Name="TsHeader" Text="TEAMSPEAK 3" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                            <TextBlock x:Name="TsDescription" Margin="0,8,0,18" Foreground="{StaticResource SecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />
                            <ItemsControl x:Name="TsLinks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Item1}"
                                                Tag="{Binding Item2}"
                                                Click="Link_Click"
                                                Style="{DynamicResource LinkButtonStyle}"
                                                Foreground="{StaticResource GoldBrush}"
                                                HorizontalContentAlignment="Left"
                                                Padding="10,8"
                                                Margin="0,0,0,5"
                                                MinHeight="38" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CommunityHeader" Text="SNAKENEST COMMUNITY" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="CommunityDescription" Grid.Row="1" Margin="0,6,0,16" FontSize="14" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Tag="https://discord.gg/9AxuZkyU7P" Click="Link_Click" Style="{DynamicResource LinkButtonStyle}" Padding="10,8" Margin="0,0,6,6" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/YacaPluginSwitcher;component/Assets/discord_icon.png" Width="25" Height="25" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="SNAKENEST COMMUNITY" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DiscordLinkText" Text="Discord Community" FontSize="12" Foreground="{StaticResource SecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="0" Grid.Column="1" Tag="https://twitch.tv/vip3r_76" Click="Link_Click" Style="{DynamicResource LinkButtonStyle}" Padding="10,8" Margin="6,0,0,6" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="25" Height="25" Stretch="Uniform" Fill="#9146FF" Margin="0,0,10,0" Data="M8,4 H56 V40 L42,54 H30 L20,64 V54 H8 Z M22,18 H28 V34 H22 Z M36,18 H42 V34 H36 Z M22,18 H42 V24 H22 Z M42,18 H48 V28 H42 Z" />
                                    <StackPanel>
                                        <TextBlock Text="ViP3R_76" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TwitchLinkText" Text="Twitch Stream" FontSize="12" Foreground="{StaticResource SecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="0" Tag="https://github.com/ViP3R76/Yaca-Plugin-Switcher" Click="Link_Click" Style="{DynamicResource LinkButtonStyle}" Padding="10,8" Margin="0,0,6,0" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/YacaPluginSwitcher;component/Assets/github_icon.png" Width="25" Height="25" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="YACA Plugin Switcher" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="GitHubLinkText" Text="Project on GitHub" FontSize="12" Foreground="{StaticResource SecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="1" Tag="https://ko-fi.com/vip3r76" Click="Link_Click" Style="{DynamicResource LinkButtonStyle}" Padding="10,8" Margin="6,0,0,0" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/YacaPluginSwitcher;component/Assets/kofi.png" Width="25" Height="25" Stretch="Uniform" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="ViP3R_76" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="KofiLinkText" Text="Ko-fi Support" FontSize="12" Foreground="{StaticResource SecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border Margin="0,14,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Padding="22">
                    <StackPanel>
                        <TextBlock x:Name="LegalHeader" Text="DISCLAIMER" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" />
                        <Border Height="1" Background="{StaticResource GoldBrush}" Opacity="0.65" Margin="0,9,0,10" />
                        <TextBlock x:Name="LegalText" Foreground="{StaticResource ForegroundBrush}" FontSize="13" FontWeight="SemiBold" LineHeight="21" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
