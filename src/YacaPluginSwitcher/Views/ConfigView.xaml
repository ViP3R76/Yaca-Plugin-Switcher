<UserControl x:Class="YacaPluginSwitcher.ConfigView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="60"/></Grid.RowDefinitions><TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold"/><Grid Grid.Row="1" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Sprache" VerticalAlignment="Center"/><ComboBox x:Name="LanguageCombo" Width="200" HorizontalAlignment="Left" SelectionChanged="Language_SelectionChanged"/></Grid><Border Grid.Row="2" Style="{StaticResource CardStyle}"><StackPanel><CheckBox x:Name="AutomaticBackup"/><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Maximale Backups" VerticalAlignment="Center"/><TextBox x:Name="MaxBackups" Width="80" HorizontalAlignment="Left"/></Grid><CheckBox x:Name="WarnRunning"/><TextBlock Text="Aktiver TeamSpeak-Pfad" Margin="0,8,0,4" Foreground="{StaticResource SecondaryBrush}"/><DockPanel><TextBox x:Name="ActivePath"/><Button Content="Durchsuchen" Click="Browse_Click" Width="110" Margin="6,0,0,0" Style="{StaticResource TileButtonStyle}"/></DockPanel></StackPanel></Border><Border Grid.Row="3" Style="{StaticResource CardStyle}"><StackPanel><CheckBox x:Name="Expert" Content="Experteneinstellungen" IsChecked="False" Checked="Expert_Changed" Unchecked="Expert_Changed"/><StackPanel x:Name="ExpertPanel" Visibility="Collapsed"><CheckBox x:Name="MultipleInstances"/><TextBlock Text="TeamSpeak-Pfade" Margin="0,10,0,4"/><ListBox x:Name="PathsList" Height="120"/><StackPanel Orientation="Horizontal"><Button Content="Hinzufügen" Click="AddPath_Click" Margin="0,5" Style="{StaticResource TileButtonStyle}"/><Button Content="Entfernen" Click="RemovePath_Click" Margin="6,5" Style="{StaticResource TileButtonStyle}"/><Button Content="Ausgewählten Pfad verwenden" Click="UsePath_Click" Margin="6,5" Style="{StaticResource TileButtonStyle}"/><Button Content="Auto-Erkennung" Click="AutoDetect_Click" Margin="6,5" Style="{StaticResource TileButtonStyle}"/></StackPanel><CheckBox x:Name="GeneralLogging"/><CheckBox x:Name="DebugLogging"/><CheckBox x:Name="SelectableBackups"/></StackPanel></StackPanel></Border><StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Speichern" Click="Save_Click" Margin="6" Style="{StaticResource TileButtonStyle}"/><Button Content="Abbrechen" Click="Cancel_Click" Margin="6" Style="{StaticResource TileButtonStyle}"/></StackPanel></Grid></ScrollViewer></UserControl>