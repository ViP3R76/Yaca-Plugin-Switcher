<UserControl x:Class="YacaPluginSwitcher.InfoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}">
<Grid Margin="6">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

<Border Grid.Row="0" Grid.Column="0" Margin="0,0,6,6" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="18">
<StackPanel>
<TextBlock Text="YACA" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
<TextBlock x:Name="YacaDescription" Margin="0,8,0,10" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
<ItemsControl x:Name="YacaLinks">
<ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Item1}" Tag="{Binding Item2}" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource AccentBrush}" HorizontalContentAlignment="Left" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
</StackPanel>
</Border>

<Border Grid.Row="0" Grid.Column="1" Margin="6,0,0,6" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="18">
<StackPanel>
<TextBlock Text="TEAMSPEAK 3" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
<TextBlock x:Name="TsDescription" Margin="0,8,0,10" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
<ItemsControl x:Name="TsLinks">
<ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Item1}" Tag="{Binding Item2}" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource AccentBrush}" HorizontalContentAlignment="Left" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
</StackPanel>
</Border>

<Border Grid.Row="1" Grid.Column="0" Margin="0,6,6,0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
<StackPanel VerticalAlignment="Center">
<TextBlock Text="SNAKENEST COMMUNITY" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
<Button Tag="https://discord.gg/9AxuZkyU7P" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,2"><StackPanel Orientation="Horizontal"><Image Source="/YacaPluginSwitcher;component/Assets/discord_icon.png" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock Text="SnakeNest Community" VerticalAlignment="Center" FontSize="14"/></StackPanel></Button>
<Button Tag="https://twitch.tv/vip3r_76" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="Twitch" Width="24" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="ViP3R_76" VerticalAlignment="Center" FontSize="14"/></StackPanel></Button>
<Button Tag="https://github.com/ViP3R76/Yaca-Plugin-Switcher" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,2"><StackPanel Orientation="Horizontal"><Image Source="/YacaPluginSwitcher;component/Assets/github_icon.png" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock Text="Repository" VerticalAlignment="Center" FontSize="14"/></StackPanel></Button>
</StackPanel>
</Border>

<Border Grid.Row="1" Grid.Column="1" Margin="6,6,0,0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
<StackPanel VerticalAlignment="Center">
<TextBlock Text="DISCLAIMER" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
<TextBlock x:Name="LegalText" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"/>
</StackPanel>
</Border>
</Grid>
</UserControl>