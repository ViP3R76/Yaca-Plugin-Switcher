<UserControl x:Class="YacaPluginSwitcher.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="6,4,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="300"/>
            <RowDefinition Height="112"/>
            <RowDefinition Height="92"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="YACA" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="YacaDescription" Margin="0,6,0,12" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="YacaLinks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Item2}" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource AccentBrush}" Height="32" Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="↗" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Item1}" FontSize="14" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Margin="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="TEAMSpeak 3" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TsDescription" Margin="0,6,0,12" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="TsLinks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Item2}" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource GoldBrush}" Height="32" Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="↗" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Item1}" FontSize="14" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6">
            <Grid>
                <TextBlock x:Name="LegalText" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center" Margin="8,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="6,2,6,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="Discord_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource AccentBrush}" Height="52" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Margin="0,0,12,0">
                        <TextBlock Text="●" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="DiscordTitle" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="DiscordSubtitle" FontSize="11" Foreground="{StaticResource SecondaryBrush}"/></StackPanel>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Click="GitHub_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource GoldBrush}" Height="52" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource GoldBrush}" BorderThickness="2" Margin="0,0,12,0">
                        <TextBlock Text="◆" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GoldBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="GitHubTitle" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="GitHubSubtitle" FontSize="11" Foreground="{StaticResource SecondaryBrush}"/></StackPanel>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>