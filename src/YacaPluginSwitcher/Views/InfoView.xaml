<UserControl x:Class="YacaPluginSwitcher.InfoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundBrush}">
<Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Margin="8,4,8,18"><TextBlock x:Name="PageTitle" Text="INFO &amp; LINKS" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="PageSubtitle" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource SecondaryBrush}"/><Border Height="1" Margin="0,14,0,0" Background="{StaticResource AccentBrush}" Opacity="0.65"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8,0,8,12">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="22"><StackPanel><TextBlock x:Name="YacaHeader" Text="YACA" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="YacaDescription" Margin="0,8,0,18" Foreground="{StaticResource SecondaryBrush}" FontSize="14" TextWrapping="Wrap"/><Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/><ItemsControl x:Name="YacaLinks"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Item1}" Tag="{Binding Item2}" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource AccentBrush}" HorizontalContentAlignment="Left" Padding="10,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Padding="22"><StackPanel><TextBlock x:Name="TsHeader" Text="TEAMSPEAK 3" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"/><TextBlock x:Name="TsDescription" Margin="0,8,0,18" Foreground="{StaticResource SecondaryBrush}" FontSize="14" TextWrapping="Wrap"/><Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/><ItemsControl x:Name="TsLinks"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Item1}" Tag="{Binding Item2}" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{StaticResource GoldBrush}" HorizontalContentAlignment="Left" Padding="10,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
</Grid>
<Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock x:Name="CommunityHeader" Text="SNAKENEST COMMUNITY" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="CommunityDescription" Margin="0,6,0,16" FontSize="14" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/><WrapPanel><Button Tag="https://discord.gg/9AxuZkyU7P" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Padding="10,8" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Image Source="/YacaPluginSwitcher;component/Assets/discord_icon.png" Width="25" Height="25" Margin="0,0,10,0"/><TextBlock x:Name="DiscordLinkText" Text="SnakeNest Community · Discord" FontSize="14" VerticalAlignment="Center"/></StackPanel></Button><Button Tag="https://twitch.tv/vip3r_76" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Padding="10,8" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Path Width="25" Height="25" Stretch="Uniform" Fill="#9146FF" Margin="0,0,10,0" Data="M8,4 H56 V40 L42,54 H30 L20,64 V54 H8 Z M22,18 H28 V34 H22 Z M36,18 H42 V34 H36 Z M22,18 H42 V24 H22 Z M42,18 H48 V28 H42 Z"/><TextBlock x:Name="TwitchLinkText" Text="ViP3R_76 · Twitch" FontSize="14" VerticalAlignment="Center"/></StackPanel></Button><Button Tag="https://github.com/ViP3R76/Yaca-Plugin-Switcher" Click="Link_Click" Style="{StaticResource LinkButtonStyle}" Padding="10,8"><StackPanel Orientation="Horizontal"><Image Source="/YacaPluginSwitcher;component/Assets/github_icon.png" Width="25" Height="25" Margin="0,0,10,0"/><TextBlock x:Name="GitHubLinkText" Text="YACA Plugin Switcher · GitHub" FontSize="14" VerticalAlignment="Center"/></StackPanel></Button></WrapPanel></StackPanel><TextBlock Grid.Column="1" Text="SNAKE&#10;NEST" Foreground="{StaticResource AccentBrush}" FontSize="30" FontWeight="Bold" Opacity="0.16" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" Margin="30,0,4,0"/></Grid></Border>
<Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22"><StackPanel><TextBlock x:Name="LegalHeader" Text="DISCLAIMER" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="LegalText" Margin="0,8,0,0" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
</StackPanel></ScrollViewer></Grid></UserControl>