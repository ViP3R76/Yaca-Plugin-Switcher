<Window x:Class="YacaPluginSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YACA Plugin Switcher - by ViP3R_76"
        Width="1536"
        Height="1024"
        MinWidth="1100"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#2B2E37"
            BorderThickness="1"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar"
                  Background="#07080C">
                <TextBlock Text="YACA Plugin Switcher"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#B5B5BC" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="—"
                            Click="Minimize_Click"
                            Style="{StaticResource ChromeButtonStyle}"
                            Focusable="False"
                            IsTabStop="False"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="□"
                            Click="Maximize_Click"
                            Style="{StaticResource ChromeButtonStyle}"
                            Focusable="False"
                            IsTabStop="False"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="×"
                            Click="Close_Click"
                            Style="{StaticResource ChromeCloseButtonStyle}"
                            Focusable="False"
                            IsTabStop="False"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="258" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="#282B34"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="18,0,18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="256" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="76" />
                            <RowDefinition Height="70" />
                            <RowDefinition Height="86" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <Image Source="/YacaPluginSwitcher;component/Assets/yaca_logo.png"
                                   Width="128"
                                   Height="128"
                                   Stretch="Uniform" />
                            <TextBlock Text="YACA"
                                       FontSize="38"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,-2,0,0" />
                            <TextBlock Text="PLUGIN SWITCHER"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GoldBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="by ViP3R_76"
                                       FontSize="13"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="NavPanel" />
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                                <TextBlock Text="☾"
                                           FontSize="22"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="Dunkelmodus"
                                           VerticalAlignment="Center"
                                           FontSize="14" />
                                <ToggleButton x:Name="DarkModeToggle"
                                              IsChecked="True"
                                              IsHitTestVisible="False"
                                              Margin="12,0,0,0"
                                              Style="{StaticResource ToggleStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◎"
                                           FontSize="21"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="Sprache"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageCombo"
                                      Width="158"
                                      Height="34"
                                      Margin="31,6,0,0"
                                      SelectionChanged="LanguageCombo_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    VerticalAlignment="Bottom"
                                    Margin="2,0,0,0">
                            <Separator Background="#8B20D5"
                                       Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14"
                                         Height="14"
                                         Fill="{StaticResource SuccessBrush}"
                                         Margin="0,0,12,0" />
                                <TextBlock x:Name="StatusText"
                                           Text="Bereit"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="VersionText"
                                       Text="v1.1.0"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="14"
                                       Margin="26,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="16,10,22,22">
                    <ContentControl x:Name="PageHost" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>